# ResearchGraph AI Environment Configuration
DJANGO_SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# Database Configuration (sqlite for local dev/testing; postgres for Docker/production)
DB_ENGINE=sqlite
POSTGRES_DB=researchgraph_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local Inference & LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=384

# Document Upload Limits
MAX_UPLOAD_SIZE_MB=30
